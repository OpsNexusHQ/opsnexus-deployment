# OpsNexus Deployment Environment Configuration Template

# PostgreSQL Credentials
POSTGRES_USER=opsnexus_user
POSTGRES_PASSWORD=opsnexus_secure_password
POSTGRES_DB=opsnexus

# Backend Configuration
OPSNEXUS_HOST=0.0.0.0
OPSNEXUS_PORT=8080
OPSNEXUS_DATABASE_URL=postgres://opsnexus_user:opsnexus_secure_password@postgres:5432/opsnexus?sslmode=disable
OPSNEXUS_TELEMETRY_RETENTION=30
OPSNEXUS_API_AUTH_ENABLED=false
OPSNEXUS_CORS_ORIGINS=*

# Dashboard Configuration
VITE_API_BASE_URL=http://localhost:8080
